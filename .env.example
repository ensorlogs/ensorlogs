# ── Supabase (proyecto → Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Brevo (smtp & api → API Keys) ────────────────────────────────────
BREVO_API_KEY=xkeysib-...
# Email verificado como remitente en Brevo
BREVO_SENDER_EMAIL=hola@ensorlogs.com
# Email que recibe las notificaciones del formulario
CONTACT_TO_EMAIL=heyensor@gmail.com
# (Opcional) ID numérico de lista de contactos en Brevo para captar leads
BREVO_LIST_ID=
# (Opcional) Lista dedicada del boletín; si no existe usa BREVO_LIST_ID
BREVO_NEWSLETTER_LIST_ID=

# URL pública del sitio (SEO, sitemap, OG)
SITE_URL=https://ensorlogs.com

# Web Push (generar con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@ensorlogs.com

# Anti-spam: Cloudflare Turnstile (gratis — dash.cloudflare.com → Turnstile)
# Sin estas claves el formulario se protege solo con honeypot + time-trap
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Chat ENSOR.AI — gratis. Sin ninguna key usa Pollinations (open-source, sin registro).
# Mejor calidad con UNA de estas keys:
# OpenRouter (modelos :free, sin tarjeta): openrouter.ai → Keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# o Gemini (free tier texto): aistudio.google.com → Get API key
GEMINI_API_KEY=
# o Groq (no disponible en Venezuela): console.groq.com
GROQ_API_KEY=
# Link de invitación a tu Discord — el bot lo comparte cuando hablan de juegos/charla
DISCORD_INVITE_URL=

# Google Search Console meta-tag content (optional)
GOOGLE_SITE_VERIFICATION=
